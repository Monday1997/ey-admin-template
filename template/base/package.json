{
  "name": "admin-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint  --cache --fix  --ext .js,.ts,.vue,.jsx,.tsx src",
    "lint:style": "npx stylelint --cache \"src/**/*.{js,jsx,vue,less,scss,css}\" --fix",
    "format": "prettier --write src/",
    "format:all": "prettier --write **.{js,jsx,vue,less,scss,css,ts}",
    "lint:all": "npm run lint && npm run lint:style"
  },
  "dependencies": {
    "@ey-use/utils": "latest",
    "@ey-use/vite-plugin": "latest",
    "@tailwindcss/vite": "^4.1.11",
    "ant-design-vue": "^4.2.6",
    "ey-admin": "latest",
    "axios": "^1.11.0",
    "pinia": "^3.0.3",
    "qs": "^6.14.0",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.8.0",
    "unplugin-vue-router": "^0.14.0",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.15.32",
    "@types/qs": "^6.14.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitejs/plugin-vue-jsx": "^5.0.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.1",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "~10.2.0",
    "jiti": "^2.4.2",
    "npm-run-all2": "^8.0.4",
    "postcss-html": "^1.8.0",
    "prettier": "3.5.3",
    "stylelint": "^16.24.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-declaration-block-no-ignored-properties": "^2.8.0",
    "stylelint-config-recess-order": "^7.3.0",
    "stylelint-config-recommended-scss": "^16.0.1",
    "stylelint-config-recommended-vue": "^1.4.0",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-order": "^7.0.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.0",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.10"
  }
}
